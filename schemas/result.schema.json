{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Cancer reproducible research submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "submitted_by",
    "created_at",
    "inputs",
    "execution",
    "artifacts",
    "findings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "submitted_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "model_or_tool": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "accessed_on",
          "query_or_filter",
          "url"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          },
          "query_or_filter": {
            "type": "string",
            "minLength": 10
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "source_release": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_path",
        "command",
        "environment"
      ],
      "properties": {
        "code_path": {
          "type": "string",
          "minLength": 3
        },
        "command": {
          "type": "string",
          "minLength": 5
        },
        "environment": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "description"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 3
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "evidence",
          "limitations",
          "review_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "statement": {
            "type": "string",
            "minLength": 20
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "record_url",
                "relation"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "record_url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "relation": {
                  "enum": [
                    "supports",
                    "contradicts",
                    "context"
                  ]
                }
              }
            }
          },
          "limitations": {
            "type": "string",
            "minLength": 20
          },
          "review_status": {
            "const": "unreviewed"
          }
        }
      }
    },
    "limitations": {
      "type": "string",
      "minLength": 20
    }
  }
}
