{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Cancer research task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "question",
    "status",
    "input_source_ids",
    "deliverables",
    "quality_checks",
    "non_goals"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 12
    },
    "question": {
      "type": "string",
      "minLength": 40
    },
    "status": {
      "enum": [
        "open",
        "in-progress",
        "complete"
      ]
    },
    "input_source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "quality_checks": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "created_on": {
      "type": "string",
      "format": "date"
    }
  }
}
